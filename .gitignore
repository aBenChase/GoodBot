# --- Secrets / environment ---
.env
.env.*
*.key
*.pem
*.p12
secrets/

# --- Private, non-public project material (NEVER commit) ---
# Holds the sensitive brief: identities, medical details, personal finances.
private/
**/private/

# --- Raw / in-progress logs: FULL CONTENT, never committed ---
logs/raw/
logs/review/
# legacy alias for logs/raw, kept ignored defensively:
logs/staging/
# NOTE: logs/receipts/ and logs/published/ are intentionally TRACKED.
#   receipts  = SHA-256 hashes + timestamps only (no content) -- the audit layer.
#   published = human-reviewed, redacted records for the website.

# --- Transient coordination state (never committed) ---
shared/TURN.lock
queue/pending/*.json
queue/done/*.json

# --- Node / Next.js ---
node_modules/
.next/
out/
dist/
build/
coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
