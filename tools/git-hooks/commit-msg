#!/bin/sh
# Good Bot commit-msg guard.
#
# Portable by design (GB-R002): uses ONLY shell builtins + git, never cat/sed/
# tail/tr/grep, so it runs even when POSIX coreutils are not on PATH.
#
# 1) Require a valid `Agent:` trailer so every commit is attributable.
# 2) Enforce directory ownership, including renames (GB-R003): an agent may not
#    edit the OTHER agent's directory unless the commit acknowledges the crossing.
set -eu

msg_file="$1"

agent=""
ack=0
while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in
    [Aa]gent:*)
      rest=${line#*:}
      while [ "${rest# }" != "$rest" ]; do rest=${rest# }; done  # ltrim spaces
      rest=${rest%% *}    # first token only
      rest=${rest%%(*}    # drop a "(model)" suffix
      agent=$rest ;;
    [Cc]ross-[Bb]oundary-[Aa]ck:*)
      ack=1 ;;
  esac
done < "$msg_file"

# A per-worktree identity, if configured, is authoritative for ownership.
cfg_agent=$(git config --get goodbot.agent 2>/dev/null || true)
[ -n "$cfg_agent" ] && agent=$cfg_agent

case "$agent" in
  claude|Claude|CLAUDE)            agent=claude ;;
  openai|OpenAI|OPENAI|Openai)     agent=openai ;;
  shared|Shared|SHARED)            agent=shared ;;
  *)
    echo "GoodBot commit-msg: missing or invalid 'Agent:' trailer." >&2
    echo "Add a trailer line:  Agent: claude   (or: openai / shared)" >&2
    exit 1 ;;
esac

# Ownership check over Added/Copied/Modified/Renamed paths and deletions.
crossed=""
for f in $(git diff --cached --name-only --diff-filter=ACMRD); do
  case "$agent:$f" in
    claude:openai/*) crossed="$crossed $f" ;;
    openai:claude/*) crossed="$crossed $f" ;;
  esac
done

if [ -n "$crossed" ] && [ "$ack" -eq 0 ]; then
  echo "GoodBot commit-msg: '$agent' is editing the other agent's directory:" >&2
  for f in $crossed; do echo "  $f" >&2; done
  echo "Note it in shared/HANDOFF.md and add:  Cross-Boundary-Ack: <reason>" >&2
  exit 1
fi
exit 0
