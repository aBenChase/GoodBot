{
  "description": "Capture Good Bot prompts and final responses for a review-gated public audit trail.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/transcript_hook.py\"",
            "commandWindows": "powershell.exe -NoProfile -Command \"$repo = git rev-parse --show-toplevel; py -3 (Join-Path $repo 'tools/transcript_hook.py')\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/transcript_hook.py\"",
            "commandWindows": "powershell.exe -NoProfile -Command \"$repo = git rev-parse --show-toplevel; py -3 (Join-Path $repo 'tools/transcript_hook.py')\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
